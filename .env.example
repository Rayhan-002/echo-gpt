# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Public base URL of this API (used to build email verification links)
APP_URL=http://localhost:3000
# Comma separated list of allowed origins, e.g. chrome-extension://<extension-id>
# Empty = allow all origins outside production
CORS_ORIGINS=
SWAGGER_ENABLED=true
# Emit structured JSON logs (recommended in production)
LOG_JSON=false

# ---------------------------------------------------------------------------
# Database (URL-encode special characters in the password, e.g. @ -> %40)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echogpt?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# 32 random bytes, base64 encoded. Encrypts AI provider API keys at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_xxxxxxxxxxx=
# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS per client
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Mail (optional). When SMTP_HOST is empty, emails are written to the log instead.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="EchoGPT <no-reply@echogpt.local>"

# ---------------------------------------------------------------------------
# AI providers (API keys are managed via the Admin API and stored encrypted in the DB)
# ---------------------------------------------------------------------------
AI_REQUEST_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------------
# duckduckgo (no key required) | tavily (requires TAVILY_API_KEY)
SEARCH_ENGINE=duckduckgo
TAVILY_API_KEY=
# 0 disables result caching
SEARCH_CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Seed (npm run db:seed)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@echogpt.local
SEED_ADMIN_PASSWORD=Admin@12345
# Optional: register AI providers on seed (keys are encrypted before storage)
SEED_OPENAI_API_KEY=
SEED_ANTHROPIC_API_KEY=
SEED_GEMINI_API_KEY=
